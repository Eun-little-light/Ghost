# 실행 파일 — 저장소에는 소스(patch\*.js · 빌드 스크립트)만, exe는 Releases에
*.exe

# 개인 데이터 (기록 · 프리셋 · 내 태그 · 설정 · 생성 이미지 · 캐릭터 폴더 연결)
BooruComfy_data/

# 빌드할 때 make.ps1이 다시 만드는 파일
patch/version.js

# 예전 실행기 · 결과 모음 이미지
patch/(예전)*
reference/*.jpg

# 마녀 화풍 참고 그림은 올리지 않음 (README의 '필요한 파일' 참고)
ref_witch.png

# 내 빌드 전용 캐릭터 이름 (저장소에 올리지 않음)
patch/charnames_local.js

# 창 exe가 엔진을 풀어 두는 숨김 폴더 · 옮겨 둔 예전 버전
.engine/
이전 버전/

# 내 빌드 전용 Hunt 인물 이름 (저장소에 올리지 않음 · 배포용엔 '✏ 인물 이름'으로 직접 정함)
patch/huntnames_local.js

# 대사 · 표정 · 인원 테스트 시트 (로컬 그림 경로 · 이름이 들어 있음)
상황_대사_견본*.html
표정_테스트_*.html
다인원_테스트_*.html

# 이미지는 저장소에 올리지 않음 (참고 그림 포함)
reference/*.png
*.png
*.jpg
*.jpeg
*.webp
